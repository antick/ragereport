---
import { THEME } from "@/config/theme";
---

<div class="theme-control" role="group" aria-label="Color theme" data-theme-controls hidden>
  {THEME.modes.map(({ value, label }) => (
    <button type="button" data-theme-mode={value} aria-pressed={value === "auto"}>
      {label}
    </button>
  ))}
</div>
