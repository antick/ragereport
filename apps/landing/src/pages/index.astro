---
import Page from "@/layouts/Page.astro";
import CliPreview from "@/components/CliPreview.astro";
import FeatureList from "@/components/FeatureList.astro";
import CommandTabs from "@/components/CommandTabs";
import ThemeControl from "@/components/ThemeControl.astro";
import { CopyButton } from "@/components/CopyButton";
import { buttonVariants } from "@/components/ui/button";
import { AGENTS, ENVIRONMENT, FAQS, INSTALL_COMMAND, SITE } from "@/config/site";
---

<Page>
  <header class="masthead section-shell">
    <a class="wordmark" href="/" aria-label="RageReport home">
      <span class="brand-mark" aria-hidden="true">
        r/r
      </span>
      ragereport<span class="brand-dot">.</span>
    </a>
    <div class="masthead-actions">
      <nav aria-label="Main navigation">
        <a href="#what-it-finds">The report</a>
        <a href={SITE.docs}>Docs</a>
        <a class="source-link" href={SITE.repository}>
          GitHub
        </a>
      </nav>
      <ThemeControl />
    </div>
  </header>
  <main id="main">
    <section class="hero section-shell" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <div class="hero-kicker">
          <span class="status-dot" aria-hidden="true"></span> A FIELD REPORT FROM YOUR TERMINAL
        </div>
        <h1 id="hero-heading">
          Your keyboard
          <br />
          has a <em>temper.</em>
        </h1>
        <p class="hero-description">
          You write code. You lose patience. You say please.
          <br class="desktop-break" /> RageReport turns your coding-agent history into
          <br class="desktop-break" /> receipts for all of it.
        </p>
        <div class="hero-actions">
          <a href="#get-started" class:list={[buttonVariants({ size: "lg" }), "primary-cta"]}>
            Run it locally
          </a>
          <a
            href={SITE.docs}
            class:list={[buttonVariants({ variant: "outline", size: "lg" }), "docs-cta"]}
          >
            See the commands
          </a>
        </div>
        <p class="hero-note">Free. Open source. Stays on your machine.</p>
      </div>
      <div class="hero-report">
        <span class="report-annotation">straight from the CLI.</span>
        <CliPreview />
      </div>
    </section>
    <section class="agents-section section-shell" aria-label="Supported coding agents">
      <div class="agents-caption">
        <span class="eyebrow">READS THE ROOM.</span>
        <p>And nine local agent histories.</p>
      </div>
      <div class="agent-list">
        {AGENTS.map((agent) => (
          <span>{agent}</span>
        ))}
      </div>
    </section>
    <FeatureList />
    <section class="commands-section section-shell" aria-labelledby="commands-heading">
      <div class="section-heading">
        <span class="eyebrow">SMALL COMMANDS. LONG MEMORY.</span>
        <h2 id="commands-heading">
          Pick your
          <br />
          <em>paper trail.</em>
        </h2>
        <p>
          A quick terminal scan or the whole browser report.
          <br />
          Use the same local history. Ask a different question.
        </p>
      </div>
      <div class="commands-box">
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span>ragereport — terminal</span>
          <span>LOCAL</span>
        </div>
        <CommandTabs client:load />
        <noscript>
          <p class="noscript-note">
            Run <code>npx ragereport scan --week</code>,{" "}
            <code>npx ragereport cost --month --offline</code>,{" "}
            <code>npx ragereport slop --week</code>, or <code>npx ragereport report --offline</code>{" "}
            on your computer.
          </p>
        </noscript>
        <div class="terminal-footer">
          <span>ENGLISH + PHONETIC HINDI</span>
          <span>NO API KEY REQUIRED</span>
        </div>
      </div>
    </section>
    <section class="privacy-section" aria-labelledby="privacy-heading">
      <div class="section-shell privacy-inner">
        <div class="privacy-symbol" aria-hidden="true">
          [local]
        </div>
        <div>
          <span class="eyebrow">YOUR HISTORY IS YOUR BUSINESS</span>
          <h2 id="privacy-heading">
            The only cloud here
            <br />
            <em>is the one over your deadline.</em>
          </h2>
          <p>
            Your conversations stay on your computer. RageReport reads your history without changing
            it, and language scans work entirely offline. Use <code>--offline</code> for cost
            reports too.
          </p>
        </div>
        <ul class="privacy-list">
          <li>No account</li>
          <li>No transcript uploads</li>
          <li>No runtime dependencies in the CLI</li>
          <li>MIT licensed</li>
        </ul>
      </div>
    </section>
    <section class="faq-section section-shell" aria-labelledby="faq-heading">
      <div class="section-heading">
        <span class="eyebrow">BEFORE YOU ASK</span>
        <h2 id="faq-heading">
          A few
          <br />
          <em>reasonable questions.</em>
        </h2>
      </div>
      <div class="faq-list">
        {FAQS.map(({ question, answer }) => (
          <details>
            <summary>
              {question}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
    <section class="start-section section-shell" id="get-started" aria-labelledby="start-heading">
      <div class="start-copy">
        <span class="eyebrow">MEET YOUR OWN RECEIPTS</span>
        <h2 id="start-heading">
          Go on.
          <br />
          <em>Run the numbers.</em>
        </h2>
        <p>
          One command. Your own numbers. Your history stays local.
          <br />
          Your sense of humor is optional.
        </p>
        <a href={SITE.docs} class="text-link">
          Read the documentation
        </a>
      </div>
      <div class="install-box">
        <div class="install-heading">
          <span>RUN WITH NPX</span>
          <CopyButton text={INSTALL_COMMAND} label="Copy npx command" client:load />
        </div>
        <pre><code>{INSTALL_COMMAND}</code></pre>
        <p>
          Node.js {ENVIRONMENT.node} · No global install
          <br />
          <a href={SITE.npm}>Available on npm</a>
        </p>
      </div>
    </section>
  </main>
  <footer class="section-shell">
    <a class="wordmark" href="/">
      ragereport<span class="brand-dot">.</span>
    </a>
    <p>
      A small tool for big feelings.
      <br />
      <a href={SITE.author}>Made by Pankaj at potion.sh</a>
    </p>
    <div>
      <a href={SITE.repository}>Source</a>
      <a href={SITE.docs}>Documentation</a>
      <a href={`${SITE.repository}/blob/main/LICENSE`}>MIT license</a>
    </div>
    <span class="footer-note">BUILT TO STAY LOCAL.</span>
  </footer>
</Page>
